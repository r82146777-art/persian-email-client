<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:background="@color/bg">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/primary"
            app:title="ایمیل موقت / اتمیک"
            app:titleTextColor="@android:color/white" />
    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            app:cardElevation="3dp"
            app:cardCornerRadius="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="آدرس فعال"
                    android:textSize="12sp"
                    android:textColor="@color/text_muted" />

                <TextView
                    android:id="@+id/activeAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text"
                    android:textIsSelectable="true"
                    android:layout_marginTop="4dp"
                    android:contentDescription="آدرس ایمیل موقت فعال" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCopy"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="کپی آدرس"
                    android:contentDescription="کپی آدرس ایمیل" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="ایجاد ایمیل جدید با نام کاربری دلخواه"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="@color/text"
                    android:contentDescription="ایجاد ایمیل جدید با نام کاربری" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/usernameInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="نام کاربری (مثلا ali2026)"
                        android:inputType="textEmailAddress"
                        android:maxLines="1"
                        android:contentDescription="نام کاربری ایمیل" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="دامنه"
                    android:textSize="12sp"
                    android:textColor="@color/text_muted" />

                <Spinner
                    android:id="@+id/domainSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:contentDescription="انتخاب دامنه" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCreateAccount"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="10dp"
                    android:text="ایجاد حساب / ایمیل جدید"
                    android:textSize="16sp"
                    android:contentDescription="ایجاد حساب ایمیل جدید با نام کاربری" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCreateRandom"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="ساخت تصادفی (بدون نام کاربری)"
                    android:contentDescription="ساخت ایمیل تصادفی" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAtomicOfficial"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="ثبت‌نام Atomic Mail رسمی (@atomicmail.io)"
                    android:contentDescription="ثبت‌نام در Atomic Mail رسمی" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSwitch"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="مدیریت آدرس‌های ذخیره‌شده"
                    android:contentDescription="مدیریت ایمیل‌های موقت" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:text="صندوق ورودی — نامه‌ها و کد تأیید اینجا می‌آیند"
            android:textSize="13sp"
            android:textColor="@color/text_muted"
            android:contentDescription="صندوق ورودی موقت" />

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="8dp"
                android:clipToPadding="false"
                android:contentDescription="فهرست نامه‌های موقت" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <TextView
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="24dp"
            android:text="هنوز نامه‌ای نرسیده. آدرس را کپی کنید و در سایت‌ها استفاده کنید."
            android:textColor="@color/text_muted"
            android:visibility="gone" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
